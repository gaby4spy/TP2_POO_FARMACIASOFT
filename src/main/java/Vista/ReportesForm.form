<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Vista.ReportesForm">
  <grid id="27dc6" binding="mainPanel" default-binding="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="800" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a1b2c" layout-manager="FlowLayout" flow-align="1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d3e4f" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Tipo de Reporte:"/>
            </properties>
          </component>
          <component id="g5h6i" class="javax.swing.JComboBox" binding="tipoReporteCombo" default-binding="true">
            <constraints/>
            <properties>
              <model>
                <item value="Medicamentos"/>
                <item value="Proveedores"/>
                <item value="Clientes"/>
                <item value="Ventas"/>
              </model>
            </properties>
          </component>
          <component id="j7k8l" class="javax.swing.JButton" binding="generarButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Generar Reporte"/>
            </properties>
          </component>
          <component id="v1w2x" class="javax.swing.JButton" binding="volverButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Volver"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="m9n0o">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="p1q2r" class="javax.swing.JTable" binding="reporteTable" default-binding="true">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>

